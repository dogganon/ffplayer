{
  "name": "ffplayer-monorepo",
  "version": "0.1.2",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ffplayer-monorepo",
      "version": "0.1.2",
      "workspaces": [
        "app/browser",
        "app/vscode",
        "app/wasm"
      ]
    },
    "app/browser": {
      "name": "@ffplayer/browser",
      "version": "0.1.1"
    },
    "app/vscode": {
      "name": "ffplayer",
      "version": "0.1.1",
      "engines": {
        "vscode": "^1.90.0"
      }
    },
    "app/wasm": {
      "name": "@ffplayer/wasm",
      "version": "0.1.1"
    },
    "node_modules/@ffplayer/browser": {
      "resolved": "app/browser",
      "link": true
    },
    "node_modules/@ffplayer/wasm": {
      "resolved": "app/wasm",
      "link": true
    },
    "node_modules/ffplayer": {
      "resolved": "app/vscode",
      "link": true
    }
  }
}
