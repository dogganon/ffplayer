{
  "name": "ffplayer-monorepo",
  "private": true,
  "version": "0.1.4",
  "workspaces": [
    "app/browser",
    "app/vscode",
    "app/wasm"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "build": "npm run build -w @ffplayer/wasm",
    "serve": "npm run serve -w @ffplayer/browser",
    "clean": "npm run clean --workspaces --if-present",
    "vscode:package": "npm run package -w app/vscode",
    "vscode:publish": "npm run vscode:publish -w app/vscode",
    "test": "node --test tests/streaming.test.cjs",
    "test:wasm": "node --test tests/wasm-io.test.cjs",
    "version": "npm version --workspaces --include-workspace-root --allow-same-version"
  }
}
