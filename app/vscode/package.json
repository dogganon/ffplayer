{
  "name": "ffplayer",
  "displayName": "ffplayer",
  "description": "FFmpeg-backed media viewer for VS Code.",
  "version": "0.1.4",
  "publisher": "ffplayer",
  "preview": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:ffplayer.mediaViewer",
    "onCustomEditor:ffplayer.mediaViewer.optional"
  ],
  "main": "./extension.js",
  "files": [
    "README.md",
    "extension.js",
    "dist/**"
  ],
  "scripts": {
    "check": "node --check extension.js && node --check vscode-viewer.js",
    "check:dist": "test -f dist/ffplayer.mjs && test -f dist/ffplayer.wasm && test -f dist/decode-worker.js && test -f dist/media-viewer.js && test -f dist/viewer.css && test -f dist/vscode-viewer.js",
    "vscode:prepublish": "npm run check:dist",
    "package": "npm run check:dist && mkdir -p dist-package && npx --yes @vscode/vsce package --pre-release --no-dependencies --allow-missing-repository --skip-license --out dist-package/ffplayer-0.1.0.vsix",
    "vscode:publish": "npm run check:dist && npx --yes @vscode/vsce publish --pre-release --no-dependencies --allow-missing-repository --skip-license -p \"$VSCE_PAT\"",
    "clean": "rm -rf dist dist-package"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "ffplayer.mediaViewer",
        "displayName": "ffplayer",
        "selector": [
          {
            "filenamePattern": "*.{3g2,3gp,aiff,asf,avi,avif,caf,f4v,flv,m2ts,m4a,m4v,mka,mkv,mov,mp4,mpeg,mpg,mxf,oga,ogg,ogm,ogv,vob,wav,webm,wma,wmv}"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "ffplayer.mediaViewer.optional",
        "displayName": "ffplayer",
        "selector": [
          {
            "filenamePattern": "*.*"
          }
        ],
        "priority": "option"
      }
    ]
  }
}
